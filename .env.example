# ==============================================================================
# Hum Medicals — Environment Variables Template (.env.example)
# ==============================================================================

# Public Canonical Site URL
NEXT_PUBLIC_SITE_URL=https://www.hummedicals.com

# Required in production: Keep signed user sessions valid across redeployments
AUTH_SECRET=replace-with-a-long-random-secret

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# Obtain from your Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Secret Service Role Key (Backend operations bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# Google Gemini AI Integration (Keep private, never prefix with NEXT_PUBLIC_)
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite
GEMINI_EDITORIAL_MODEL=gemini-3.5-flash

# Comma-separated editor accounts. Defaults to hummedicals@gmail.com when omitted.
ADMIN_EMAILS=hummedicals@gmail.com

# Real email delivery (Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Hum Medicals <updates@your-verified-domain.com>
CONTACT_EMAIL=hummedicals@gmail.com
