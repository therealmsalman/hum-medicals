# Public canonical URL used by metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.hummedicals.com

# Replace before production. Required to keep signed sessions valid across deployments.
AUTH_SECRET=replace-with-a-long-random-secret

# Supabase PostgreSQL Database Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini server-side AI tools. Keep this private; never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite
GEMINI_EDITORIAL_MODEL=gemini-3.5-flash

# Comma-separated editor accounts. Defaults to hummedicals@gmail.com when omitted.
ADMIN_EMAILS=hummedicals@gmail.com

# Real email delivery (Resend). EMAIL_FROM must use a verified Resend sending domain.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Hum Medicals <updates@your-verified-domain.com>
CONTACT_EMAIL=hummedicals@gmail.com
