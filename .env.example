# Public canonical URL used by metadata, sitemap, and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.hummedicals.com

# Replace before production. Required to keep signed sessions valid across deployments.
AUTH_SECRET=replace-with-a-long-random-secret

# Persistent account storage for Vercel. The Upstash integration adds these automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Google Gemini server-side AI tools. Keep this private; never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite

# Real email delivery (Resend). EMAIL_FROM must use a verified Resend sending domain.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Hum Medicals <updates@your-verified-domain.com>
CONTACT_EMAIL=hummedicals@gmail.com
